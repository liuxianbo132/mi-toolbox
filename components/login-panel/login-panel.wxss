.login {
    padding: 36rpx 32rpx;
    background: var(--color-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
}

.login-title {
    display: block;
    font-size: 34rpx;
    font-weight: 700;
    color: var(--color-text-1);
}

.login-desc {
    display: block;
    margin-top: 12rpx;
    font-size: 24rpx;
    line-height: 1.6;
    color: var(--color-text-3);
}

.login-input {
    height: 80rpx;
    padding: 0 24rpx;
    margin-top: 28rpx;
    font-size: 28rpx;
    color: var(--color-text-1);
    background: var(--color-bg);
    border-radius: var(--radius-md);
}

.login-placeholder {
    color: var(--color-text-3);
}

.login-row {
    display: flex;
    align-items: center;
}

.login-code {
    flex: 1;
    margin-top: 20rpx;
}

.login-send {
    flex-shrink: 0;
    margin: 20rpx 0 0 20rpx;
    padding: 0 24rpx;
    height: 80rpx;
    line-height: 80rpx;
    font-size: 26rpx;
    color: var(--color-primary);
    background: var(--color-primary-light);
    border-radius: var(--radius-md);
}

.login-send-disabled {
    color: var(--color-text-3);
    background: var(--color-bg);
}

.login-button {
    margin-top: 28rpx;
    height: 84rpx;
    line-height: 84rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #ffffff;
    background: var(--color-primary);
    border-radius: var(--radius-md);
}

.login-button::after {
    border: none;
}

.login-tip {
    display: block;
    margin-top: 20rpx;
    font-size: 24rpx;
    color: var(--color-green);
}

.login-error {
    display: block;
    margin-top: 20rpx;
    font-size: 24rpx;
    color: var(--color-red);
}
