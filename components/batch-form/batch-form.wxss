/* 批次表单组件：使用全局设计令牌（CSS 变量沿 DOM 继承，组件内可直接引用） */

.bf-mode {
  display: flex;
  background: #F0F2F5;
  border-radius: var(--radius-sm);
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.bf-mode-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  box-sizing: border-box;
  text-align: center;
  padding: 8rpx 4rpx;
  font-size: var(--font-sm);
  line-height: 1.35;
  color: var(--color-text-2);
  border-radius: 6rpx;
}

.bf-mode-active {
  background: var(--color-card);
  color: var(--color-primary);
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.bf-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.bf-label {
  width: 170rpx;
  color: var(--color-text-2);
  font-size: var(--font-sm);
  flex-shrink: 0;
}

.bf-flex {
  flex: 1;
  min-width: 0;
}

.bf-picker {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  box-sizing: border-box;
  background: var(--color-bg);
  border: 1rpx solid transparent;
  border-radius: var(--radius-sm);
  padding: 8rpx 20rpx;
  font-size: var(--font-md);
  line-height: 1.4;
  color: var(--color-text-1);
  word-break: break-all;
}

.bf-placeholder {
  color: var(--color-text-3);
}

.bf-ipt {
  min-height: 88rpx;
  box-sizing: border-box;
  background: var(--color-bg);
  border: 1rpx solid transparent;
  border-radius: var(--radius-sm);
  padding: var(--space-2) 20rpx;
  font-size: var(--font-md);
  color: var(--color-text-1);
}

.bf-calc {
  color: var(--color-primary);
  font-weight: 500;
}

.bf-hint {
  padding-left: 186rpx;
  color: var(--color-text-3);
  font-size: var(--font-xs);
  margin-bottom: var(--space-2);
}

.bf-large .bf-mode-item {
  font-size: 28rpx;
}

.bf-large .bf-label {
  font-size: 28rpx;
}

.bf-large .bf-picker,
.bf-large .bf-ipt {
  min-height: 100rpx;
  font-size: 32rpx;
}

.bf-large .bf-calc {
  font-size: 32rpx;
}

.bf-large .bf-hint {
  font-size: 28rpx;
  line-height: 1.6;
}
