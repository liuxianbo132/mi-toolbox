<view class="page-root {{largeText ? 'large-text' : ''}}">
<view wx:if="{{authState === 'checking'}}" class="center">加载中…</view>

<view wx:elif="{{authState === 'signed-out'}}" class="card login-card">
  <button class="btn-primary login-btn" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="onWechatLogin">微信一键登录</button>
  <text wx:if="{{loginError}}" class="err">{{loginError}}</text>
</view>

<view wx:else>
  <view wx:if="{{loadError}}" class="card center-hint">
    <view>{{loadError}}</view>
    <button size="mini" class="btn-ghost" bindtap="retryInventoryLoad">重试</button>
  </view>
  <view wx:elif="{{!household}}" class="card center-hint">先到「临期看板」创建家庭，或用家人分享的邀请码加入，再回来管理库存</view>
  <block wx:else>
    <view class="card inventory-tools">
      <input class="ipt search-input" placeholder="搜索名称、品牌、规格或条码" value="{{searchText}}" bindinput="onSearchInput" confirm-type="search" />
      <view class="filter-row">
        <picker class="filter-picker" mode="selector" range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="filter-value">{{categoryOptions[categoryIndex].label}}</view>
        </picker>
        <picker class="filter-picker" mode="selector" range="{{locationOptions}}" range-key="name" value="{{locationIndex}}" bindchange="onLocationChange">
          <view class="filter-value">{{locationOptions[locationIndex].name}}</view>
        </picker>
        <picker class="filter-picker sort-picker" mode="selector" range="{{sortOptions}}" value="{{sortIndex}}" bindchange="onSortChange">
          <view class="filter-value">{{sortOptions[sortIndex]}}</view>
        </picker>
      </view>
      <button size="mini" class="btn-ghost clear-filters" bindtap="clearInventoryFilters">清空搜索与筛选</button>
      <view wx:if="{{itemsLimited || batchDataLimited}}" class="limit-hint">{{itemsLimited ? '搜索范围限最近的 1000 件物品' : ''}}{{itemsLimited && batchDataLimited ? '；' : ''}}{{batchDataLimited ? '位置与到期筛选最多参考 3000 个在库批次' : ''}}</view>
    </view>
    <view class="card action-row">
      <button class="btn-primary add-btn" bindtap="goCreate">＋ 新增物品</button>
      <button class="btn-ghost scan-btn" bindtap="gobarcode">扫码</button>
    </view>
    <view class="loc-entry" bindtap="golocations">
      <text>管理存放位置</text>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{items.length === 0}}" class="card center-hint">
      <view>{{allItems.length === 0 ? '还没有物品记录' : '没有符合条件的物品'}}</view>
      <button wx:if="{{allItems.length === 0}}" size="mini" class="btn-primary" bindtap="goCreate">去录入</button>
    </view>
    <block wx:else>
      <view wx:for="{{groups}}" wx:for-item="g" wx:key="key" class="group">
        <view class="group-head">
          <image class="group-ico" src="{{g.illu}}" mode="aspectFit" />
          <text>{{g.label}}（{{g.count}}）</text>
        </view>
        <view wx:for="{{g.items}}" wx:for-item="item" wx:key="id" class="card item-row" data-id="{{item.id}}" bindtap="goDetail">
          <view class="item-main">
            <view class="item-name">{{item.name}}</view>
            <view class="item-meta">{{item.brand || ''}} {{item.spec || ''}}</view>
          </view>
          <text class="loc-badge {{item.locKnown ? 'loc-known' : ''}}">{{item.locText}}</text>
          <view class="arrow">›</view>
        </view>
      </view>
    </block>
  </block>
</view>
</view>
