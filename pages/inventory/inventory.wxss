/* 页面独有样式；公共类（center、login、err、center-hint）已收编至 app.wxss */

.action-row {
  display: flex;
  gap: var(--space-2);
  padding: 20rpx var(--space-3);
}

.add-btn {
  flex: 1;
}

.scan-btn {
  width: 180rpx;
  flex-shrink: 0;
}

.loc-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 88rpx;
  padding: 0 var(--space-3);
  color: var(--color-primary);
  font-size: var(--font-xs);
}

.large-text .loc-entry,
.large-text .group-head {
  font-size: 28rpx;
  line-height: 1.6;
}

.loc-badge {
  flex-shrink: 0;
  background: rgba(120, 120, 128, 0.12);
  color: var(--color-text-3);
  border-radius: var(--radius-sm);
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  margin-right: 12rpx;
}

.loc-known {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.group {
  margin-top: var(--space-2);
}

.group-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 var(--space-3);
  margin-bottom: var(--space-1);
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text-2);
}

.group-ico {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
  min-height: 112rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: var(--font-lg);
  font-weight: 600;
  line-height: 1.35;
}

.item-meta {
  color: var(--color-text-3);
  font-size: var(--font-xs);
  margin-top: 4rpx;
  line-height: 1.45;
}

.inventory-tools { padding: var(--space-3); }
.search-input { width: 100%; }
.filter-row { display: flex; align-items: stretch; gap: 10rpx; margin-top: var(--space-2); }
.filter-picker { flex: 1; min-width: 0; }
.sort-picker { flex: 0.9; }
.filter-value {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 8rpx 10rpx;
  border-radius: var(--radius-sm);
  background: rgba(120, 120, 128, 0.08);
  color: var(--color-text-2);
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  word-break: break-all;
}
.clear-filters { display: block; min-height: 88rpx; margin: var(--space-2) auto 0; }
.limit-hint { margin-top: var(--space-2); color: var(--color-text-3); font-size: 24rpx; line-height: 1.5; text-align: center; }

.arrow {
  color: #C7C7CC;
  font-size: var(--font-lg);
  margin-left: 12rpx;
}
