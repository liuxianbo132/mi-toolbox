/* 库存页 · 分组容器 + 信息完整的文件卡片（Unslop 精修版） */

.page { padding-bottom: 48rpx; }

.inventory-tools {
  padding: 24rpx;
}
.tool-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.tool-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-text-1);
}
.tool-sub {
  font-size: 24rpx;
  color: var(--color-text-2);
}
.search-input { width: 100%; }

.filter-row {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  margin-top: 16rpx;
}
.filter-picker { flex: 1; min-width: 0; }
.sort-picker { flex: 0.9; }
.filter-value {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-height: 88rpx;
  padding: 8rpx 10rpx;
  border-radius: var(--radius-sm);
  background: rgba(120, 120, 128, 0.08);
  color: var(--color-text-2);
  font-size: 24rpx;
  line-height: 1.35;
  text-align: center;
}
.filter-value text {
  min-width: 0;
  word-break: break-all;
}
.filter-arrow {
  width: 18rpx;
  height: 18rpx;
  opacity: 0.5;
  transform: rotate(90deg);
  flex-shrink: 0;
}
.clear-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}
.limit-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text-2);
  text-align: center;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.add-btn { flex: 1; }
.scan-btn { width: 180rpx; flex-shrink: 0; }
.loc-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 88rpx;
  margin-top: 8rpx;
  padding: 0 8rpx;
  color: var(--color-primary-ink);
  font-size: 26rpx;
}
.loc-arrow {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.5;
  transform: rotate(90deg);
}

/* 分组容器：一个卡片 + 细分隔线，替代每张物品一个悬浮卡 */
.group-card {
  margin: 16rpx 24rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.group-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  padding: 12rpx 24rpx 8rpx;
}
.group-ico {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
}
.group-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-2);
}
.group-count {
  font-size: 24rpx;
  color: var(--color-text-2);
}
.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 128rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid var(--color-border);
}
.item-illu {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #F3F6FC;
  flex-shrink: 0;
}
.item-main { flex: 1; min-width: 0; }
.item-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--color-text-1);
  word-break: break-all;
}
.item-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--color-text-2);
  word-break: break-all;
}
.item-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}
.stock-num {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-1);
  white-space: nowrap;
}
.stock-num.is-low { color: var(--color-amber); }
.stock-tag {
  padding: 4rpx 12rpx;
  white-space: nowrap;
}
.row-arrow {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.4;
  flex-shrink: 0;
  transform: rotate(90deg);
}

/* 状态卡片：错误、无家庭、空列表共用 */
.state-card {
  margin-top: 32rpx;
  text-align: center;
}
.state-card.compact {
  margin-top: 24rpx;
}
.state-icon {
  width: 96rpx;
  height: 96rpx;
}
.state-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.state-desc {
  margin: 8rpx 0 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-2);
}

/* 登录卡片标题沿用全局类；按钮使用全局 88rpx 触控尺寸 */
.login-card { margin-top: 120rpx; }
