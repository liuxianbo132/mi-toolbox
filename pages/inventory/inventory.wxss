.inventory-page {
  padding: 16rpx var(--space-4) 48rpx;
}

.inventory-head,
.filter-selection {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}

.inventory-head .section-title {
  font-size: var(--font-xl);
  font-weight: 650;
  line-height: 1.3;
}

.inventory-count,
.filter-selection,
.limit-hint,
.group-count {
  color: var(--color-text-2);
  font-size: var(--font-sm);
  line-height: 1.45;
}

.inventory-actions {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}

.inventory-actions button { flex: 1; min-width: 0; margin: 0; }
.inventory-actions .inventory-secondary { flex: 0 0 34%; gap: 8rpx; padding: 0 8rpx; }
.scan-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }

.ipt.inventory-search {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: var(--color-card);
}

.filter-toolbar,
.stock-tabs {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-toolbar { justify-content: space-between; flex-wrap: wrap; margin-top: 8rpx; }
.stock-tabs { flex-wrap: wrap; }

.stock-tab,
.filter-button,
.clear-button,
.loc-entry {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  width: auto !important;
  margin: 0;
  padding: 0 16rpx;
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--color-text-2);
  font-size: var(--font-sm);
  line-height: 1.35;
}

.stock-tab::after,
.filter-button::after,
.clear-button::after,
.loc-entry::after { border: 0; }

.stock-tab.is-selected,
.filter-button.is-selected {
  font-weight: 600;
  background: var(--color-primary-light);
  color: var(--color-primary-ink);
}

.clear-button,
.filter-button,
.loc-entry { color: var(--color-primary-ink); }

.filter-panel {
  margin-top: 8rpx;
  padding: 8rpx 16rpx 0;
  border-radius: var(--radius-lg);
  background: var(--color-card);
}

.filter-row { display: flex; flex-wrap: wrap; gap: 8rpx; }
.filter-picker { flex: 1; min-width: 0; }
.filter-value {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 8rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  color: var(--color-text-2);
  font-size: var(--font-sm);
  line-height: 1.35;
}
.filter-value text { min-width: 0; overflow-wrap: break-word; }
.filter-arrow,
.loc-arrow,
.row-arrow { width: 20rpx; height: 20rpx; opacity: 0.6; flex-shrink: 0; }
.loc-arrow,
.row-arrow { transform: rotate(90deg); }
.filter-panel .loc-entry { width: 100% !important; justify-content: space-between; }

.filter-selection { align-items: center; flex-wrap: nowrap; }
.filter-selection text { min-width: 0; overflow-wrap: break-word; }
.clear-button { flex-shrink: 0; }
.limit-hint { margin: 12rpx 0 16rpx; }

.inventory-group { margin-top: 20rpx; }
.group-head { display: flex; align-items: baseline; gap: 12rpx; margin: 0 16rpx 8rpx; }
.group-label { font-size: var(--font-md); font-weight: 600; color: var(--color-text-2); }

.group-card,
.inventory-skeleton {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.item-row,
.skeleton-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 112rpx;
  padding: 12rpx 20rpx;
}

.item-row + .item-row,
.skeleton-row + .skeleton-row { border-top: 1rpx solid var(--color-border); }

.item-illu,
.skeleton-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--color-bg);
  flex-shrink: 0;
}
.item-main { flex: 1; min-width: 0; }
.item-name { font-size: 30rpx; font-weight: 600; line-height: 1.35; overflow-wrap: break-word; }
.item-meta { margin-top: 3rpx; font-size: 24rpx; line-height: 1.45; color: var(--color-text-2); overflow-wrap: break-word; }
.item-side { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; flex: 0 1 auto; max-width: 34%; }
.stock-num { font-size: var(--font-sm); font-weight: 600; text-align: right; overflow-wrap: anywhere; }
.stock-num.is-low, .expiry-soon { color: var(--color-amber); }
.expiry-risk { color: var(--color-red); }
.stock-tag { padding: 4rpx 8rpx; text-align: right; }

.inventory-skeleton { margin-top: 24rpx; }
.skeleton-lines { flex: 1; }
.skeleton-lines view { width: 55%; height: 20rpx; border-radius: 8rpx; background: var(--color-bg); }
.skeleton-lines view + view { width: 80%; margin-top: 12rpx; }

.login-card { margin-top: 120rpx; }

.large-text .stock-tab,
.large-text .filter-button,
.large-text .clear-button,
.large-text .filter-selection,
.large-text .inventory-count,
.large-text .group-count,
.large-text .stock-num { font-size: 28rpx; }
.large-text .group-label { font-size: 32rpx; }
.large-text .item-row { min-height: 128rpx; }
