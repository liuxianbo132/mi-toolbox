.adherence-page { padding: var(--space-2) var(--space-4) 48rpx; }
.report-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-1) var(--space-2);
  margin: 0 var(--space-1) var(--space-2);
  color: var(--color-text-2);
  font-size: var(--font-sm);
}
.report-title { color: var(--color-text-1); font-size: var(--font-xl); font-weight: 700; line-height: 1.25; }
.report-group { margin: var(--space-3) 0 0; padding: var(--space-3); }

.range-tabs {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  background: rgba(120, 120, 128, 0.10);
  border-radius: var(--radius-md);
}
.range-tab {
  flex: 1;
  min-height: 88rpx;
  margin: 0;
  padding: var(--space-2);
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--color-text-2);
  font-size: var(--font-sm);
  line-height: 1.4;
}
.range-tab::after { border: 0; }
.range-tab.on { background: var(--color-card); color: var(--color-primary-ink); font-weight: 600; }

.rate-card {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-2);
}
.rate-value { display: flex; align-items: baseline; color: var(--color-primary-ink); }
.rate-num {
  font-size: 92rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}
.rate-unit { margin-left: 4rpx; font-size: var(--font-lg); font-weight: 600; }
.rate-label, .rate-sub {
  color: var(--color-text-2);
  font-size: var(--font-sm);
  line-height: 1.6;
}

.chart-box {
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-border);
}
.chart-heading { font-weight: 600; margin-bottom: var(--space-2); }
.chart-scroll { width: 100%; white-space: nowrap; }
.chart-bars { display: flex; align-items: flex-end; min-width: 100%; }
.bar-cell {
  flex: 1;
  min-width: 72rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}
.bar { width: 24rpx; margin-top: 6rpx; border-radius: 6rpx 6rpx 0 0; background: var(--color-primary-ink); }
.bar-value, .bar-label {
  color: var(--color-text-2);
  font-size: 22rpx;
  line-height: 1.35;
  white-space: nowrap;
}
.bar-label { width: 100%; text-align: center; border-top: 1rpx solid var(--color-border); padding: 6rpx 0; }

.report-note {
  margin-top: var(--space-2);
  color: var(--color-text-2);
  font-size: var(--font-sm);
  line-height: 1.6;
}
.missed-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--space-1) var(--space-2);
  min-height: 88rpx;
  padding: var(--space-2) 0;
}
.missed-row + .missed-row { border-top: 1rpx solid var(--color-border); }
.missed-when {
  flex-shrink: 0;
  color: var(--color-text-2);
  font-size: var(--font-sm);
  font-variant-numeric: tabular-nums;
}
.missed-name { flex: 1; min-width: 120rpx; font-weight: 600; overflow-wrap: anywhere; }

.large-text .report-title { font-size: 52rpx; }
.large-text .rate-num { font-size: 110rpx; }
.large-text .range-tab,
.large-text .report-heading,
.large-text .rate-label,
.large-text .rate-sub,
.large-text .report-note,
.large-text .bar-label,
.large-text .bar-value,
.large-text .missed-when { font-size: 28rpx; }
.large-text .bar-cell { min-width: 104rpx; }
.large-text .missed-name { font-size: 34rpx; }
