<view class="page-root {{largeText ? 'large-text' : ''}}">
  <view wx:if="{{authState === 'checking'}}" class="center">正在加载家人成员…</view>

  <view wx:elif="{{authState === 'signed-out'}}" class="card login-card">
    <button class="btn-primary login-btn" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="onwechatlogin">微信一键登录</button>
    <text wx:if="{{loginError}}" class="err">{{loginError}}</text>
  </view>

  <view wx:elif="{{authState === 'no-household'}}" class="card center-hint">请先在首页创建或加入家庭</view>
  <view wx:elif="{{loading}}" class="center">正在统计打卡记录…</view>

  <view wx:elif="{{loadError}}" class="card">
    <view class="card-title">{{loadError}}</view>
    <button class="btn-ghost" bindtap="retryload">重新加载</button>
  </view>

  <view wx:else class="adherence-page">
    <view class="report-heading">
      <view class="report-title">服药记录概览</view>
      <text>{{memberName}}</text>
    </view>
    <view class="range-tabs">
      <button class="range-tab {{range === 'week' ? 'on' : ''}}" data-range="week" bindtap="switchrange" aria-pressed="{{range === 'week'}}">本周</button>
      <button class="range-tab {{range === 'month' ? 'on' : ''}}" data-range="month" bindtap="switchrange" aria-pressed="{{range === 'month'}}">本月</button>
    </view>

    <view class="card report-group">
      <view class="rate-card">
        <view>
          <view class="rate-label">记录确认率</view>
          <view class="rate-value"><text class="rate-num">{{rateText}}</text><text wx:if="{{hasRate}}" class="rate-unit">%</text></view>
        </view>
        <view class="rate-sub">
          <view>已确认 {{taken}}</view>
          <view>标记漏服 {{missed}}</view>
          <view>待确认 {{pending}}</view>
        </view>
      </view>

      <view wx:if="{{hasRate}}" class="chart-box">
        <view class="chart-heading">每日记录确认率</view>
        <scroll-view class="chart-scroll" scroll-x="{{chartScroll}}" enable-flex>
          <view class="chart-bars">
            <view class="bar-cell" wx:for="{{chart}}" wx:key="key" aria-label="{{item.label}}，{{item.summary}}">
              <text class="bar-value">{{item.summary}}</text>
              <view wx:if="{{item.barH}}" class="bar" style="height: {{item.barH}}rpx"></view>
              <text class="bar-label">{{item.label}}</text>
            </view>
          </view>
        </scroll-view>
      </view>
      <view wx:else class="report-note">范围内没有可计入确认率的记录。</view>

      <view class="report-note">记录确认率 = 已确认 ÷（已确认 + 标记漏服）。</view>
    </view>

    <view class="card report-group">
      <view class="card-title">标记漏服的记录</view>
      <view wx:if="{{missedList.length === 0}}" class="report-note">所选范围内暂无记录</view>
      <view wx:elif="{{missed > missedList.length}}" class="report-note">显示最近 {{missedList.length}} 条，共 {{missed}} 条</view>
      <view wx:for="{{missedList}}" wx:key="id" class="missed-row">
        <view class="missed-when">{{item.dateText}} {{item.timeText}}</view>
        <view class="missed-name">{{item.name}}</view>
      </view>
    </view>
  </view>
</view>
