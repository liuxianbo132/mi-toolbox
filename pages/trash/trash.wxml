<view class="page-root {{largeText ? 'large-text' : ''}}">
  <view wx:if="{{authState === 'checking'}}" class="center">正在读取家庭信息…</view>
  <view wx:elif="{{authState === 'signed-out'}}" class="card center-hint">请先登录后查看</view>
  <view wx:elif="{{authState === 'no-household'}}" class="card center-hint">请先在首页创建或加入家庭</view>
  <state-view wx:elif="{{authState === 'error' || contentState === 'error'}}" icon="/assets/icons/alertCircle-red.svg" title="回收站暂时无法加载" desc="请检查网络连接后重试" action-text="重试" bindaction="retrytrash" />
  <view wx:elif="{{contentState === 'loading'}}" class="center">正在读取回收站…</view>

  <view wx:else class="trash-page">
    <view wx:if="{{contentLimited}}" class="trash-note">回收站记录较多，当前仅显示最新记录。</view>

    <view wx:if="{{itemRows.length > 0}}" class="trash-section">
      <view class="trash-heading">物品（{{itemRows.length}}）</view>
      <view class="trash-group">
        <view wx:for="{{itemRows}}" wx:for-item="r" wx:key="id" class="trash-row">
          <view class="trash-main">
            <view class="trash-title">{{r.name}}</view>
            <view class="trash-meta">{{r.categoryText}}<text wx:if="{{r.deletedText}}"> · 删除于 {{r.deletedText}}</text></view>
          </view>
          <view class="trash-actions">
            <button size="mini" class="btn-ghost" data-id="{{r.id}}" disabled="{{busy}}" bindtap="onrestoreitem">恢复</button>
            <button size="mini" class="purge-button" data-id="{{r.id}}" disabled="{{busy}}" bindtap="onpurgeitem">彻底删除</button>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{batchRows.length > 0}}" class="trash-section">
      <view class="trash-heading">独立批次（{{batchRows.length}}）</view>
      <view class="trash-group">
        <view wx:for="{{batchRows}}" wx:for-item="r" wx:key="id" class="trash-row">
          <view class="trash-main">
            <view class="trash-title">
              {{r.itemName}}
              <text wx:if="{{r.expired}}" class="tag-red trash-tag">已过期</text>
            </view>
            <view class="trash-meta">{{r.expiryText}}<text wx:if="{{r.deletedText}}"> · 删除于 {{r.deletedText}}</text></view>
          </view>
          <view class="trash-actions">
            <button size="mini" class="btn-ghost" data-id="{{r.id}}" disabled="{{busy}}" bindtap="onrestorebatch">恢复</button>
            <button size="mini" class="purge-button" data-id="{{r.id}}" disabled="{{busy}}" bindtap="onpurgebatch">彻底删除</button>
          </view>
        </view>
      </view>
    </view>

    <state-view wx:if="{{itemRows.length === 0 && batchRows.length === 0}}" icon="/assets/icons/tray.svg" title="{{contentLimited ? '最新记录中没有可单独恢复的批次' : '回收站为空'}}" />
  </view>
</view>
