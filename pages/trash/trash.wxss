.trash-page { margin: var(--space-3) var(--space-4) 48rpx; }
.trash-heading, .trash-note { margin: 0 0 12rpx; color: var(--color-text-2); font-size: var(--font-sm); line-height: 1.45; }
.trash-heading { font-weight: 600; }
.trash-section + .trash-section { margin-top: var(--space-3); }
.trash-group { background: var(--color-card); border-radius: var(--radius-lg); padding: 0 var(--space-3); }

.trash-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  border-top: 1rpx solid var(--color-border);
}

.trash-row:first-child {
  border-top: none;
}

.trash-main {
  flex: 1;
  min-width: 180rpx;
}

.trash-title {
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.trash-tag {
  margin-left: var(--space-1);
  font-size: var(--font-xs);
  font-weight: 500;
}

.trash-meta {
  margin-top: 6rpx;
  color: var(--color-text-3);
  font-size: var(--font-xs);
  line-height: 1.45;
}

.trash-actions {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
.purge-button { color: var(--color-red); background: transparent; }
.purge-button::after { border: none; }
.large-text .trash-actions { width: 100%; }
.large-text .trash-heading, .large-text .trash-note { font-size: 30rpx; }

/* 大字模式：标题与二级信息跟随放大，触控尺寸沿用全局 mini 规则 */
.large-text .trash-title {
  font-size: 38rpx;
  line-height: 1.4;
}

.large-text .trash-meta {
  font-size: 28rpx;
  line-height: 1.6;
}
