<view class="page-root {{largeText ? 'large-text' : ''}}">
  <view wx:if="{{authState === 'checking'}}" class="center">正在验证登录状态…</view>

  <view wx:elif="{{authState === 'signed-out'}}" class="card login-card">
    <image class="login-mascot" src="/assets/illustrations/v3/mascot/welcome.png" mode="aspectFit" aria-hidden="true" />
    <view class="app-title">小咪工具箱</view>
    <view class="app-sub">家庭物品与用药管理</view>
    <button class="btn-primary login-btn" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="onwechatlogin">微信一键登录</button>
    <text wx:if="{{loginError}}" class="err">{{loginError}}</text>
  </view>

  <state-view wx:elif="{{householdError}}" icon="/assets/icons/alertCircle-red.svg" title="{{householdErrorTitle}}" desc="{{householdError}}" action-text="重新加载" bindaction="retryhousehold" />

  <view wx:elif="{{householdLoading}}" class="center">正在读取家庭信息…</view>

  <view wx:elif="{{!household}}" class="family-setup">
    <view class="family-intro">
      <image class="family-mascot" src="/assets/illustrations/v3/scenes/family.png" mode="aspectFit" aria-hidden="true" />
      <view class="app-title">设置家庭空间</view>
      <view class="app-sub">和家人共享库存与用药记录</view>
    </view>
    <view class="card">
      <view class="card-title">创建家庭</view>
      <input class="ipt" aria-label="家庭名称" placeholder="输入家庭名称" value="{{createName}}" maxlength="40" bindinput="oncreatenameinput" />
      <button class="btn-primary setup-button" disabled="{{familyBusy}}" bindtap="createhousehold">创建家庭</button>
    </view>
    <view class="card">
      <view class="card-title">加入已有家庭</view>
      <input class="ipt" aria-label="邀请码" placeholder="输入家人分享的邀请码" value="{{joinCode}}" bindinput="onjoincodeinput" />
      <button class="btn-ghost setup-button" disabled="{{familyBusy}}" bindtap="joinhousehold">加入家庭</button>
    </view>
  </view>

  <view wx:else class="page board">
    <view class="hero">
      <view class="hero-copy">
        <button class="family-link" hover-class="row-hover" bindtap="goprofile">{{household.name}}<text class="family-arrow">›</text></button>
        <view class="hero-title">今日概览</view>
      </view>
      <image class="hero-mascot" src="/assets/illustrations/v3/mascot/welcome.png" mode="aspectFit" aria-hidden="true" />
    </view>

    <view class="stats-card">
      <view class="stat-cell">
        <view class="stat-num label-red">{{urgentState === 'ready' ? stats.expired : '—'}}</view>
        <view class="stat-label">已过期</view>
      </view>
      <view class="stat-cell">
        <view class="stat-num label-amber">{{urgentState === 'ready' ? stats.danger + stats.warn : '—'}}</view>
        <view class="stat-label">需留意</view>
      </view>
      <view class="stat-cell">
        <view class="stat-num label-green">{{urgentState === 'ready' ? stats.safe : '—'}}</view>
        <view class="stat-label">未临期</view>
      </view>
    </view>
    <view wx:if="{{urgentState === 'ready' && urgentLimited}}" class="board-note">批次较多，统计仅包含已加载的在库批次</view>
    <view wx:if="{{urgentState === 'ready' && undatedCount}}" class="board-note">{{undatedCount}} 个已加载批次缺少有效到期日</view>

    <button wx:if="{{medicationSummaryState === 'ready' && missedToday > 0}}" class="board-alert" hover-class="row-hover" bindtap="gomedication">
      <image class="alert-ico" src="/assets/icons/bell-red.svg" />
      <text class="alert-text">今日{{medicationLimited ? '至少' : ''}} {{missedToday}} 次记为漏服</text>
      <text class="alert-arrow">›</text>
    </button>

    <view class="quick">
      <button class="btn-primary quick-item" hover-class="button-hover" bindtap="goadd"><text class="quick-label">添加物品</text></button>
      <button class="btn-ghost quick-item" hover-class="button-hover" bindtap="goscan">
        <image class="quick-ico" src="/assets/icons/scan.svg" />
        <text class="quick-label">扫码录入</text>
      </button>
    </view>

    <view class="board-section">
      <view class="section-head">
        <view class="section-title">今日用药</view>
        <button class="section-more" hover-class="row-hover" bindtap="gomedication">查看用药 <text>›</text></button>
      </view>
      <view class="section-card">
        <view wx:if="{{medicationSummaryState === 'loading'}}" class="empty-inline">正在汇总今日用药…</view>
        <view wx:elif="{{medicationSummaryState === 'error'}}" class="board-state">
          <text>今日用药暂时无法加载</text>
          <button size="mini" class="btn-ghost" bindtap="retrymedication">重试</button>
        </view>
        <view wx:elif="{{!todayDoseTotal}}" class="empty-inline">今日暂无用药安排</view>
        <view wx:else class="dose-summary">
          <view class="dose-counts">
            <text>已记录 {{takenToday}} / {{todayDoseTotal}} 次</text>
            <text wx:if="{{pendingToday}}">待记录 {{pendingToday}} 次</text>
          </view>
          <view wx:if="{{nextDose}}" class="next-dose">待记录 <text class="next-dose-time">{{nextDose.time}}</text>{{nextDose.name ? ' · ' + nextDose.name : ''}}</view>
          <view wx:if="{{medicationLimited}}" class="board-note">今日记录较多，摘要仅包含已加载的记录</view>
        </view>
      </view>
      <view wx:if="{{streakDays > 0}}" class="streak">
        <image src="/assets/icons/checkCircle-green.svg" />
        <text class="streak-text">连续打卡 {{streakDays}} 天</text>
      </view>
    </view>

    <view class="board-section">
      <view class="section-head">
        <view class="section-title">临期与过期</view>
        <button class="section-more" hover-class="row-hover" bindtap="goinventory">查看库存 <text>›</text></button>
      </view>
      <view class="section-card">
        <view wx:if="{{urgentState === 'loading'}}" class="empty-inline">正在汇总临期物品…</view>
        <view wx:elif="{{urgentState === 'error'}}" class="board-state">
          <text>库存风险暂时无法加载</text>
          <button size="mini" class="btn-ghost" bindtap="retryurgent">重试</button>
        </view>
        <view wx:elif="{{urgentRows.length === 0}}" class="empty-inline">{{urgentLimited ? '已加载批次暂无临期或过期记录' : '暂无临期或过期批次'}}</view>
        <block wx:else>
          <button wx:for="{{urgentRows}}" wx:for-item="b" wx:key="id" class="risk-row" hover-class="row-hover" data-id="{{b.itemId}}" bindtap="godetail">
            <image class="row-illu" src="{{b.illustration}}" mode="aspectFit" />
            <view class="row-main">
              <view class="row-name">{{b.name}}</view>
              <view class="row-sub">{{b.daysLabel}}<text wx:if="{{b.qtyText}}"> · {{b.qtyText}}</text></view>
            </view>
            <text class="row-tag {{b.tagClass}}">{{b.tagText}}</text>
          </button>
          <view wx:if="{{allUrgent && urgentPageCount > 1}}" class="list-pagination">
            <button size="mini" class="btn-ghost" disabled="{{urgentPage <= 1}}" data-step="-1" bindtap="urgentpagination">上一页</button>
            <text>{{urgentPage}} / {{urgentPageCount}}</text>
            <button size="mini" class="btn-ghost" disabled="{{urgentPage >= urgentPageCount}}" data-step="1" bindtap="urgentpagination">下一页</button>
          </view>
          <button wx:if="{{hasMoreUrgent || allUrgent}}" class="list-more" hover-class="row-hover" bindtap="toggleurgent">{{allUrgent ? '收起' : (urgentLimited ? '查看已加载的风险批次' : '查看全部临期与过期批次')}}</button>
        </block>
      </view>
    </view>

    <button wx:if="{{restockCount > 0}}" class="board-alert restock" hover-class="row-hover" bindtap="gorestockinventory">
      <image class="alert-ico" src="/assets/icons/alertCircle.svg" />
      <text class="restock-text">{{restockState === 'partial' ? '已确认 ' : ''}}{{restockCount}} 件物品待补货</text>
      <text class="alert-arrow">›</text>
    </button>
    <view wx:if="{{restockState === 'partial'}}" class="board-note">部分物品的批次数量或单位待核对，请前往库存查看</view>
    <view wx:elif="{{restockState === 'limited'}}" class="board-note">库存较多，请到库存页查看待补货物品</view>
    <view wx:elif="{{restockState === 'error' && urgentState === 'ready'}}" class="board-state">
      <text>补货摘要暂不可用</text>
      <button size="mini" class="btn-ghost" bindtap="retryurgent">重试</button>
    </view>
  </view>
</view>
