/* 页面独有样式；公共类（center、login、app 标题、err、card-title、form-row、ipt、center-hint）已收编至 app.wxss */

.alert-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-red-bg);
  color: var(--color-red);
  border-radius: var(--radius-md);
  margin: var(--space-2) var(--space-3) 0;
  padding: var(--space-2) var(--space-3);
  font-size: var(--font-sm);
}

.alert-arrow {
  font-size: var(--font-lg);
}

.divider {
  text-align: center;
  color: var(--color-text-3);
  margin: 20rpx 0;
  font-size: var(--font-xs);
}

.stats {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  margin: var(--space-2) var(--space-3);
  padding: var(--space-3) 0;
  box-shadow: var(--shadow-card);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 600;
}

.stat-num.red { color: var(--color-red); }
.stat-num.amber { color: var(--color-amber); }
.stat-num.green { color: var(--color-green); }

.stat-label {
  color: var(--color-text-3);
  font-size: var(--font-xs);
  margin-top: 4rpx;
}

.urgent-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.uc-main {
  flex: 1;
  min-width: 0;
}

.uc-name {
  font-size: var(--font-md);
  font-weight: 500;
}

.uc-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}

.uc-qty {
  color: var(--color-text-3);
  font-size: var(--font-xs);
}

.uc-side {
  flex-shrink: 0;
  text-align: right;
  margin-left: var(--space-2);
}

.uc-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

.uc-num.red {
  color: var(--color-red);
}

.uc-num.amber {
  color: var(--color-amber);
}

.uc-label {
  font-size: 20rpx;
  color: var(--color-text-3);
  margin-top: 2rpx;
}
