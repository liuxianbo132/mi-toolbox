.board {
  padding: 20rpx var(--space-4) var(--space-4);
}
.board .row-hover { background: var(--color-primary-light); }
.board .board-alert.row-hover { background: var(--color-red-bg); opacity: 0.76; }
.board .restock.row-hover { background: var(--color-amber-bg); }
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}
.hero-copy { min-width: 0; flex: 1; }
.family-link {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  min-height: 88rpx;
  max-width: 100%;
  padding: 0;
  width: auto !important;
  margin: 0 auto 0 0 !important;
  justify-content: flex-start;
  background: transparent;
  color: var(--color-primary-ink);
  font-size: var(--font-sm);
  line-height: 1.35;
  text-align: left;
  word-break: break-all;
}
.family-link::after,
.board-alert::after,
.risk-row::after,
.section-more::after,
.list-more::after { border: none; }
.family-arrow,
.alert-arrow { flex-shrink: 0; font-size: 36rpx; line-height: 1; }
.hero-title { font-size: var(--font-xl); font-weight: 700; line-height: 1.2; }
.hero-mascot { width: 144rpx; height: 144rpx; flex-shrink: 0; }

.stats-card {
  display: flex;
  padding: 20rpx 0;
  background: var(--color-card);
  border-radius: var(--radius-lg);
}
.stat-cell { flex: 1; min-width: 0; padding: 0 var(--space-1); text-align: center; }
.stat-cell + .stat-cell { border-left: 1rpx solid var(--color-border); }
.stat-num {
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.12;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-text-2);
  line-height: 1.4;
}
.label-red { color: var(--color-red); }
.label-amber { color: var(--color-amber); }
.label-green { color: var(--color-green); }
.board-note {
  margin-top: var(--space-1);
  color: var(--color-text-2);
  font-size: var(--font-sm);
  line-height: 1.5;
}
.board-alert {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  width: 100% !important;
  box-sizing: border-box;
  min-height: 88rpx;
  margin: var(--space-2) 0 0;
  padding: 12rpx var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-red-bg);
  color: var(--color-red);
  font-size: var(--font-md);
  line-height: 1.4;
  text-align: left;
}
.board-alert .alert-text, .board-alert .restock-text { flex: 1; min-width: 0; }
.alert-ico { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.restock { background: var(--color-amber-bg); color: var(--color-amber); }
.quick { display: flex; gap: var(--space-2); margin-top: var(--space-2); }
.quick .quick-item {
  flex: 1;
  min-width: 0;
  min-height: 92rpx;
  gap: var(--space-1);
  margin: 0;
  padding: 10rpx var(--space-2);
  line-height: 1.35;
}
.quick-ico { width: 32rpx; height: 32rpx; flex-shrink: 0; }

.board-section { margin-top: var(--space-2); }
.section-head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-1); }
.section-title { font-size: var(--font-lg); font-weight: 600; line-height: 1.4; }
.section-more {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
  min-height: 88rpx;
  width: auto !important;
  padding: 0 0 0 12rpx;
  margin: 0;
  background: transparent;
  color: var(--color-primary-ink);
  font-size: var(--font-sm);
  line-height: 1.4;
}
.section-more text { font-size: 34rpx; line-height: 1; }
.section-card { overflow: hidden; background: var(--color-card); border-radius: var(--radius-lg); }
.empty-inline, .board-state, .dose-summary { padding: 22rpx var(--space-3); }
.empty-inline, .board-state { font-size: var(--font-sm); color: var(--color-text-2); line-height: 1.5; }
.board-state { display: flex; gap: var(--space-2); align-items: center; justify-content: space-between; }
.board-state button { flex-shrink: 0; }
.dose-counts {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx var(--space-2);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 1.4;
}
.next-dose { margin-top: 8rpx; color: var(--color-text-2); font-size: var(--font-sm); line-height: 1.5; word-break: break-all; }
.next-dose-time { font-weight: 600; }
.streak { display: flex; align-items: center; gap: 8rpx; margin: var(--space-1) 0 0 4rpx; color: var(--color-green); }
.streak image { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.streak-text { font-size: var(--font-sm); line-height: 1.4; }

.risk-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  width: 100% !important;
  box-sizing: border-box;
  min-height: 112rpx;
  padding: 16rpx var(--space-3);
  margin: 0;
  border-radius: 0;
  background: transparent;
  color: var(--color-text-1);
  text-align: left;
  line-height: 1.4;
}
.risk-row + .risk-row, .list-more { border-top: 1rpx solid var(--color-border); }
.row-illu {
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: var(--color-bg);
  flex-shrink: 0;
}
.row-main { flex: 1; min-width: 0; }
.row-name { font-size: var(--font-md); font-weight: 600; word-break: break-all; }
.row-sub { margin-top: 4rpx; font-size: var(--font-sm); color: var(--color-text-2); }
.row-tag { flex-shrink: 0; line-height: 1.45; }
.list-more {
  width: 100% !important;
  min-height: 88rpx;
  padding: 14rpx var(--space-3);
  border-radius: 0;
  background: transparent;
  color: var(--color-primary-ink);
  font-size: var(--font-sm);
  line-height: 1.4;
}
.list-pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-1);
  padding: 12rpx var(--space-3);
  border-top: 1rpx solid var(--color-border);
  color: var(--color-text-2);
  font-size: var(--font-sm);
}

.login-card { margin: 64rpx var(--space-4) var(--space-4); padding: var(--space-4); }
.login-mascot { display: block; width: 300rpx; height: 300rpx; margin: 0 auto var(--space-2); }
.login-btn { width: 100%; }
.family-setup { padding-bottom: var(--space-4); }
.family-intro { padding: var(--space-3) var(--space-4) 0; text-align: center; }
.family-intro .app-sub { margin-bottom: 24rpx; }
.family-mascot { width: 208rpx; height: 208rpx; }
.setup-button { margin-top: var(--space-2); }

.large-text .hero-mascot { width: 120rpx; height: 120rpx; }
.large-text .family-link,
.large-text .board-note,
.large-text .board-state,
.large-text .dose-counts,
.large-text .next-dose,
.large-text .list-pagination,
.large-text .list-more { font-size: 30rpx; }
.large-text .quick-item { min-height: 104rpx; }
.large-text .row-illu { width: 64rpx; height: 64rpx; }
