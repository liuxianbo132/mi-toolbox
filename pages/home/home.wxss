/* 首页 · 家庭今日概览（Unslop 精修版：安静的蓝白界面 + 三色业务状态） */

.page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: var(--color-bg);
  overflow: hidden;
}

.cat-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 640rpx;
  z-index: 0;
  opacity: 0.42;
  pointer-events: none;
}

.topbar,
.hero,
.stats-card,
.data-note,
.alert-bar,
.alert-restock,
.section-card,
.quick {
  position: relative;
  z-index: 1;
}

/* 家庭标识 */
.topbar { padding: 24rpx 32rpx 0; }
.brand {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  max-width: 100%;
}
.brand-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.brand-ico { width: 44rpx; height: 44rpx; }
.brand-name {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-text-1);
  min-width: 0;
  word-break: break-all;
}
.brand-arrow {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.4;
  transform: rotate(90deg);
  flex-shrink: 0;
}

/* 今日概览 */
.hero { padding: 28rpx 32rpx 32rpx; }
.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.25;
  color: var(--color-text-1);
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-text-2);
}

/* 三态统计 */
.stats-card {
  display: flex;
  margin: 0 24rpx;
  padding: 28rpx 8rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-cell + .stat-cell { border-left: 1rpx solid var(--color-border); }
.stat-solid { width: 72rpx; height: 72rpx; }
.stat-num {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.15;
  color: var(--color-text-1);
}
.stat-label {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--color-text-2);
}
.label-red { color: var(--color-red); }
.label-amber { color: var(--color-amber); }
.label-green { color: var(--color-green); }
.data-note {
  margin: 12rpx 32rpx 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text-2);
}

/* 提醒条 */
.alert-bar,
.alert-restock {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-md);
}
.alert-bar { background: var(--color-red-bg); }
.alert-restock { background: var(--color-amber-bg); }
.alert-ico,
.restock-ico { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.alert-text,
.restock-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}
.alert-text { color: var(--color-red); }
.restock-text { color: var(--color-amber); }
.alert-action {
  font-size: 24rpx;
  color: var(--color-red);
  white-space: nowrap;
}
.alert-arrow,
.restock-arrow {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

/* 分组卡片 */
.section-card {
  margin: 20rpx 24rpx;
  padding-bottom: 8rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 12rpx;
}
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.section-ico { width: 40rpx; height: 40rpx; }
.section-more {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 88rpx;
  padding: 0 0 0 24rpx;
  margin: -20rpx 0;
  font-size: 26rpx;
  color: var(--color-text-2);
}
.more-arrow { width: 20rpx; height: 20rpx; opacity: 0.5; }

.zone { margin-top: 4rpx; }
.zone-head {
  display: flex;
  align-items: center;
  /* 覆盖 app.wxss 全局 .zone-head 的 space-between，避免圆点与标题分离 */
  justify-content: flex-start;
  padding: 12rpx 28rpx 4rpx;
}
.zone-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.dot-red { background: var(--color-red); }
.dot-amber { background: var(--color-amber); }
.zone-title {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-2);
}

/* 列表行 */
.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 16rpx 28rpx;
}
.row + .row { border-top: 1rpx solid var(--color-border); }
.row-illu {
  width: 76rpx;
  height: 76rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #F3F6FC;
  flex-shrink: 0;
}
.row-main { flex: 1; min-width: 0; }
.row-name {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
  color: var(--color-text-1);
  word-break: break-all;
}
.row-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--color-text-2);
}
.progress {
  margin-top: 8rpx;
  height: 8rpx;
  background: #E9EDF3;
  border-radius: 4rpx;
  overflow: hidden;
}
.progress-fill { height: 100%; border-radius: 4rpx; }
.fill-red { background: var(--color-red); }
.fill-amber { background: var(--color-amber); }
.row-tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 500;
}
.row-arrow { width: 22rpx; height: 22rpx; opacity: 0.4; flex-shrink: 0; }

/* 空态与状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 40rpx;
}
.empty-illu { width: 140rpx; height: 140rpx; }
.empty-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-1);
}
.empty-hint {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
}
.empty-inline {
  padding: 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-2);
}
.state-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 28rpx 28rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
}
.state-card {
  margin-top: 160rpx;
  text-align: center;
}
.state-icon { width: 64rpx; height: 64rpx; }
.state-title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.state-desc {
  margin: 8rpx 0 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-2);
}

/* 今日用药 */
.dose-row { min-height: 116rpx; }
.dose-featured { background: var(--color-primary-light); }
.dose-featured + .dose-row { border-top: 0; }
.dose-featured .row-illu { background: rgba(255, 255, 255, 0.72); }
.dose-status { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.dose-time { font-size: 24rpx; color: var(--color-text-2); }
.streak {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 24rpx 20rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-amber-bg);
}
.streak-ico { width: 32rpx; height: 32rpx; }
.streak-text { font-size: 26rpx; font-weight: 500; color: var(--color-amber); }
.streak-hint { margin-left: auto; font-size: 24rpx; color: var(--color-text-2); }

/* 快捷入口：一个安静的容器，不用四个独立悬浮卡 */
.quick {
  display: flex;
  gap: 8rpx;
  margin: 20rpx 24rpx 40rpx;
  padding: 16rpx 8rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 136rpx;
  padding: 12rpx 4rpx;
  border-radius: var(--radius-md);
}
.quick-badge {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-ico { width: 40rpx; height: 40rpx; }
.quick-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.3;
  color: var(--color-text-2);
  text-align: center;
}

/* 登录与家庭表单（沿用全局设计令牌） */
.login-card { margin-top: 160rpx; text-align: center; }
.login-btn { width: 80%; }
.divider { margin: 20rpx 0; font-size: 24rpx; color: var(--color-text-2); }
