<view class="page-root {{largeText ? 'large-text' : ''}}">
<view wx:if="{{authState === 'checking'}}" class="center">加载中…</view>

<view wx:elif="{{authState === 'signed-out'}}" class="card login-card">
  <button class="btn-primary login-btn" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="onWechatLogin">微信一键登录</button>
  <text wx:if="{{loginError}}" class="err">{{loginError}}</text>
</view>

<view wx:elif="{{authState === 'no-household'}}" class="card center-hint">请先在「临期看板」创建或加入家庭</view>

<view wx:else>
  <view wx:if="{{summary}}" class="card summary-card">
    <view class="card-title">本月概览</view>
    <view class="sum-grid">
      <view class="sum-cell">
        <view class="sum-num green">{{summary.create}}</view>
        <view class="sum-label">入库</view>
      </view>
      <view class="sum-cell">
        <view class="sum-num blue">{{summary.open}}</view>
        <view class="sum-label">开封</view>
      </view>
      <view class="sum-cell">
        <view class="sum-num">{{summary.use_up}}</view>
        <view class="sum-label">用完</view>
      </view>
      <view class="sum-cell">
        <view class="sum-num red">{{summary.discard}}</view>
        <view class="sum-label">报废</view>
      </view>
    </view>
    <view class="ratio-row">
      <text class="ratio-label">消耗率</text>
      <view class="ratio-bar">
        <view class="ratio-fill" style="width: {{summary.consumeRate}}%"></view>
      </view>
      <text class="ratio-value">{{summary.rateText}}</text>
    </view>
    <view class="summary-hint">{{summary.wasteText}}{{summary.capped ? '（已达 1000 条统计上限）' : ''}}</view>
    <view wx:if="{{filter !== 'all'}}" class="filter-note">上方概览为全量统计，不随筛选变化</view>
  </view>

  <view class="card">
    <view class="card-title">操作记录（{{records.length}}）</view>
    <view class="rec-filters">
      <view wx:for="{{filters}}" wx:for-item="f" wx:key="key" class="rec-chip {{filter === f.key ? 'rec-chip-active' : ''}}" hover-class="row-hover" data-key="{{f.key}}" bindtap="onfilter" aria-label="筛选{{f.label}}记录">{{f.label}}</view>
    </view>
    <view wx:for="{{records}}" wx:for-item="r" wx:key="id" class="rec-row">
      <view class="rec-main">
        <view class="rec-title">
          <text class="rec-action {{r.actionClass}}">{{r.actionLabel}}</text>
          <text class="rec-item">{{r.itemName}}</text>
        </view>
        <view class="rec-meta">{{r.ownerName}}<text wx:if="{{r.qtyText}}"> · 数量 {{r.qtyText}}</text></view>
      </view>
      <view class="rec-time">{{r.timeText}}</view>
    </view>
    <view wx:if="{{records.length === 0}}" class="hint-sm">{{filter === 'all' ? '暂无操作记录' : '该动作暂无记录'}}</view>
  </view>
</view>
</view>
