/* 操作记录页；公共类已收编至 app.wxss */

.hint-sm {
  color: var(--color-text-3);
  font-size: var(--font-xs);
  padding: 12rpx 0;
  text-align: center;
}

.rec-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  border-top: 1rpx solid var(--color-border);
}

.rec-row:first-child {
  border-top: none;
}

.rec-main {
  flex: 1;
  min-width: 0;
}

.rec-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.rec-action {
  flex-shrink: 0;
}

.rec-item {
  flex: 1;
  min-width: 0;
  font-size: var(--font-md);
  line-height: 1.4;
  word-break: break-all;
}

.rec-meta {
  color: var(--color-text-3);
  font-size: var(--font-xs);
  margin-top: 6rpx;
  line-height: 1.45;
}

.rec-time {
  flex-shrink: 0;
  color: var(--color-text-3);
  font-size: var(--font-xs);
  line-height: 1.4;
}

/* 动作标签：开封用品牌色、用完为中性地灰 */
.rec-open {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: var(--radius-sm);
  padding: 4rpx 12rpx;
  font-size: var(--font-xs);
}

.rec-ghost {
  background: rgba(120, 120, 128, 0.12);
  color: var(--color-text-2);
  border-radius: var(--radius-sm);
  padding: 4rpx 12rpx;
  font-size: var(--font-xs);
}

/* ===== 本月概览（四类动作 + 消耗率） ===== */

.sum-grid {
  display: flex;
  margin-top: 8rpx;
}

.sum-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sum-num {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--color-text-1);
}

.sum-num.green {
  color: var(--color-green);
}

.sum-num.blue {
  color: var(--color-primary);
}

.sum-num.red {
  color: var(--color-red);
}

.sum-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}

.ratio-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 26rpx;
}

.ratio-label {
  font-size: 24rpx;
  color: var(--color-text-2);
  flex-shrink: 0;
}

.ratio-bar {
  flex: 1;
  height: 10rpx;
  background: #F0F0F3;
  border-radius: 5rpx;
  overflow: hidden;
}

.ratio-fill {
  height: 100%;
  background: linear-gradient(90deg, #7BE3A0, #34C759);
  border-radius: 5rpx;
}

.ratio-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-1);
  flex-shrink: 0;
}

.summary-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-3);
}
