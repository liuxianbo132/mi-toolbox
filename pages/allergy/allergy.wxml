<view class="page-root {{largeText ? 'large-text' : ''}}">
  <view wx:if="{{authState === 'checking'}}" class="center">正在加载成员档案…</view>

  <view wx:elif="{{authState === 'signed-out'}}" class="card login-card">
    <button class="btn-primary login-btn" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="onWechatLogin">微信一键登录</button>
    <text wx:if="{{loginError}}" class="err">{{loginError}}</text>
  </view>

  <view wx:elif="{{authState === 'no-household'}}" class="card center-hint">请先在首页创建或加入家庭</view>
  <view wx:elif="{{authState === 'forbidden'}}" class="card center-hint">仅本人或管理员可管理当前家庭成员的档案</view>

  <view wx:elif="{{authState === 'error'}}" class="card">
    <view class="card-title">{{loadError}}</view>
    <button class="btn-ghost" bindtap="restore">重新加载</button>
  </view>

  <view wx:else class="allergy-page">
    <view class="allergy-member">{{memberName}}</view>

    <view class="card allergy-group">
      <view class="card-title">已登记过敏原</view>
      <view wx:if="{{loadState === 'loading'}}" class="allergy-status">正在加载过敏原…</view>
      <view wx:elif="{{loadState === 'error'}}" class="allergy-status">
        <view>{{loadError}}</view>
        <button class="btn-ghost allergy-action" bindtap="loadAllergens">重试</button>
      </view>
      <block wx:else>
        <view wx:if="{{allergens.length === 0}}" class="allergy-status">暂无登记</view>
        <view wx:for="{{allergens}}" wx:for-item="a" wx:key="id" class="allergen-row">
          <text class="allergen-name">{{a.allergen}}</text>
          <button class="btn-danger allergy-action" disabled="{{saving}}" data-id="{{a.id}}" data-allergen="{{a.allergen}}" bindtap="removeAllergen" aria-label="移除过敏原 {{a.allergen}}">移除</button>
        </view>
      </block>
    </view>

    <view class="card allergy-group">
      <view class="card-title">添加过敏原</view>
      <view class="form-row allergy-entry">
        <input class="ipt" value="{{newAllergen}}" bindinput="onNewInput" placeholder="如花生" maxlength="20" disabled="{{saving || loadState !== 'ready'}}" aria-label="请输入一个过敏原" />
        <button class="btn-primary allergy-action" disabled="{{saving || loadState !== 'ready'}}" bindtap="addAllergen">添加</button>
      </view>
      <view class="form-hint">每次登记一种。提示依据过敏原与药品关联的文本匹配，具体用药请遵医嘱。</view>
    </view>
  </view>
</view>
