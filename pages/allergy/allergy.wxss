.allergy-page { padding: var(--space-2) var(--space-4) var(--space-4); }
.allergy-member {
  margin: 0 0 var(--space-2) var(--space-1);
  font-size: var(--font-xl);
  font-weight: 700;
  line-height: 1.25;
  overflow-wrap: anywhere;
}
.allergy-group { margin: 0; padding: var(--space-3); }

.allergen-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
  min-height: 108rpx;
  padding: var(--space-1) 0;
}
.allergen-row + .allergen-row { border-top: 1rpx solid var(--color-border); }
.allergen-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.allergy-action {
  flex-shrink: 0;
  margin: 0;
  padding: 0 var(--space-2);
  font-size: var(--font-sm);
}

.allergy-entry { margin-bottom: 0; }
.allergy-entry .ipt { min-width: 0; }
.allergy-status, .form-hint {
  color: var(--color-text-2);
  font-size: var(--font-sm);
  line-height: 1.55;
}
.form-hint { margin-top: var(--space-2); }
.allergy-status .allergy-action { margin-top: var(--space-2); }
.large-text .allergy-member { font-size: 52rpx; }
.large-text .allergy-status { font-size: 28rpx; }
.large-text .allergy-entry { flex-wrap: wrap; }
.large-text .allergy-entry .ipt { flex-basis: 100%; }
