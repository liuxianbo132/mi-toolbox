/* 存放位置管理页；公共类已收编至 app.wxss */

.hint-sm {
  color: var(--color-text-3);
  font-size: var(--font-xs);
  padding: 12rpx 0;
  text-align: center;
}

.loc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  border-top: 1rpx solid var(--color-border);
}

.loc-row:first-child {
  border-top: none;
}

.loc-name {
  font-size: var(--font-md);
  flex: 1;
  min-width: 0;
}

.loc-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.loc-rename-input {
  min-width: 0;
}
