.profile { padding: var(--space-3) var(--space-4) 48rpx; }
.profile-head { display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-3); }
.profile-mark { width: 88rpx; height: 88rpx; border-radius: var(--radius-md); background: var(--color-primary-light); flex-shrink: 0; }
.profile-copy { min-width: 0; }
.profile-title { font-size: var(--font-xl); font-weight: 700; line-height: 1.2; word-break: break-all; }
.profile-sub { margin-top: 6rpx; font-size: var(--font-sm); line-height: 1.45; color: var(--color-text-2); word-break: break-all; }

.login-card { margin: 96rpx var(--space-4) var(--space-4); }
.page-root > .settings-group { margin: 0 var(--space-4); }
.login-btn { width: 100%; }
.settings-section + .settings-section { margin-top: var(--space-3); }
.group-title {
  color: var(--color-text-2);
  margin: 0 0 var(--space-1) var(--space-2);
  font-size: var(--font-sm);
  font-weight: 600;
  line-height: 1.5;
}
.settings-group { overflow: hidden; background: var(--color-card); border-radius: var(--radius-lg); }
.setting-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  gap: var(--space-2);
  padding: 12rpx var(--space-3);
  box-sizing: border-box;
  font-size: var(--font-md);
  line-height: 1.45;
}
.setting-row + .setting-row { border-top: 1rpx solid var(--color-border); }
.setting-button {
  width: 100% !important;
  max-width: none !important;
  margin: 0;
  border-radius: 0;
  color: var(--color-text-1);
  background: transparent;
  text-align: left;
  font-weight: 500;
}
.setting-button::after { border: none; }
.setting-button[disabled] { opacity: 0.54; }
.setting-button.row-hover { background: var(--color-primary-light); }
.setting-main, .setting-title { min-width: 0; flex: 1; }
.setting-detail { color: var(--color-text-2); font-size: var(--font-sm); text-align: right; word-break: break-all; }
.entry-arrow { flex-shrink: 0; color: var(--color-text-2); font-size: 36rpx; line-height: 1; }
.arrow-open { transform: rotate(90deg); }
.code { color: var(--color-primary-ink); font-weight: 650; letter-spacing: 1rpx; }
.nickname-input {
  min-height: 88rpx;
  margin-top: var(--space-1);
  padding: 12rpx var(--space-2);
  line-height: 1.35;
}
.nickname-row > button { flex-shrink: 0; align-self: flex-end; }
.preference-row { justify-content: space-between; }
.preference-title { font-size: var(--font-md); font-weight: 500; }
.preference-hint, .member-meta { margin-top: 4rpx; color: var(--color-text-2); font-size: var(--font-sm); line-height: 1.45; }
.member-row { background: var(--color-bg); }
.member-name { font-size: var(--font-md); font-weight: 600; line-height: 1.45; word-break: break-all; }
.self-tag {
  display: inline-block;
  margin-left: var(--space-1);
  padding: 2rpx var(--space-1);
  border-radius: var(--radius-sm);
  background: var(--color-primary-light);
  color: var(--color-primary-ink);
  font-size: var(--font-xs);
}
.member-button { flex-shrink: 0; }
.danger-row { color: var(--color-red); }

.large-text .profile-title { font-size: 52rpx; }
.large-text .profile-sub,
.large-text .group-title,
.large-text .setting-detail { font-size: 30rpx; }
.large-text .setting-row { min-height: 104rpx; font-size: 34rpx; }
.large-text .member-row { align-items: flex-start; flex-direction: column; }
