/* 页面独有样式；公共类（center、login、app-title、err、btn-danger）已收编至 app.wxss */

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
  padding: 12rpx 0;
}

.row .label {
  flex-shrink: 0;
}

.row > text:last-child {
  min-width: 0;
  text-align: right;
  word-break: break-all;
}

.label {
  color: var(--color-text-3);
}

/* V3：昵称行——输入框吃掉剩余宽度，保存按钮不换行 */
.nickname-row .ipt {
  flex: 1;
  min-width: 0;
  min-height: 64rpx;
  padding: 10rpx 18rpx;
  font-size: var(--font-sm);
  text-align: right;
}

.nickname-row button {
  flex-shrink: 0;
}

.code {
  color: var(--color-primary);
}

.member-list {
  margin-top: var(--space-1);
}

.member-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-2) 0;
  border-top: 1rpx solid var(--color-border);
}

.member-row:first-child {
  border-top: none;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.self-tag {
  display: inline-block;
  margin-left: var(--space-1);
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
}

.member-meta {
  color: var(--color-text-3);
  font-size: var(--font-xs);
  margin-top: 4rpx;
  line-height: 1.45;
}

.member-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.member-empty {
  text-align: center;
  color: var(--color-text-3);
  font-size: var(--font-xs);
  padding: var(--space-2) 0;
}

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-md);
}

.entry-arrow {
  color: #C7C7CC;
  font-size: var(--font-lg);
}

.preference-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.preference-copy { flex: 1; min-width: 0; }
.preference-title { font-size: var(--font-md); font-weight: 600; }
.preference-hint { margin-top: 6rpx; color: var(--color-text-3); font-size: var(--font-xs); line-height: 1.45; }

.export-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.export-hint {
  margin-top: var(--space-2);
}

.trash-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trash-entry-main {
  flex: 1;
  min-width: 0;
}

.trash-entry-arrow {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.3;
  flex-shrink: 0;
}
