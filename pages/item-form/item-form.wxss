.ipt-flex { flex: 1; min-width: 0; }
.entry-form { padding-bottom: calc(132rpx + env(safe-area-inset-bottom)); }
.entry-card { margin-inline: var(--space-4); }

.entry-head,
.location-error {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.entry-head .card-title { margin: 0; }
.entry-head .recognize-btn, .form-retry { margin: 0; min-height: 88rpx; padding: 0 16rpx; }
.recognize-btn { font-size: var(--font-sm); gap: 8rpx; }
.recognize-ico { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.recognize-hint,
.entry-note {
  color: var(--color-text-2);
  font-size: var(--font-sm);
  line-height: 1.45;
  margin: 8rpx 0 16rpx;
}
.entry-save-error, .location-error { color: var(--color-red); line-height: 1.5; margin-bottom: 16rpx; }
.entry-save-error { margin: 16rpx 0 0; }

.save-bar {
  position: fixed;
  z-index: 5;
  right: 0;
  left: 0;
  bottom: 0;
  padding: 16rpx var(--space-4) calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  border-top: 1rpx solid var(--color-border);
}
.save-bar button { width: 100%; margin: 0; }
.center-hint .form-retry { margin: 16rpx auto 0; }

.large-text .entry-form { padding-bottom: calc(144rpx + env(safe-area-inset-bottom)); }
.large-text .entry-card .form-row { align-items: stretch; flex-direction: column; gap: 8rpx; }
.large-text .entry-card .f-label { text-align: left; width: auto; }
