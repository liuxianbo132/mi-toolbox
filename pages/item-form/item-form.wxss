/* 页面独有样式；公共类（center、login、err、card-title、form-row、ipt、f-label、center-hint）已收编至 app.wxss */

.ipt-flex {
  flex: 1;
}

.save-btn {
  margin-top: var(--space-3);
  width: 100%;
}

.barcode-value {
  color: var(--color-text-2);
  line-height: 1.4;
}

.low-stock-hint {
  padding: 8rpx 0 12rpx;
  text-align: left;
}

/* 视觉录入按钮：整行、次要视觉层级 */
.recognize-btn {
  width: 100%;
  margin-bottom: var(--space-3);
  font-size: var(--font-md);
  font-weight: 500;
  gap: 12rpx;
}

.recognize-ico {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.recognize-btn text {
  flex: 1;
  min-width: 0;
  text-align: left;
  line-height: 1.4;
}

.recognize-hint {
  margin: calc(-1 * var(--space-2)) 0 var(--space-3);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-3);
  text-align: center;
}
