/* 用药页 · 清晰的今日时间线与 Plans（Unslop 精修版） */

.page { padding-bottom: 48rpx; }

.entry-bar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 0;
}
.entry-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  min-height: 88rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-md);
  background: var(--color-card);
  box-shadow: var(--shadow-card);
  color: var(--color-primary-ink);
  font-size: 26rpx;
}
.entry-ico { width: 36rpx; height: 36rpx; }

.allergy-alert {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 24rpx 0;
  padding: 12rpx 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-amber-bg);
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-amber);
}
.allergy-ico { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.allergy-alert text { flex: 1; }

.section-card {
  margin: 20rpx 24rpx;
  padding-bottom: 12rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 8rpx 24rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-text-1);
}
.empty-inline {
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-2);
}
.medication-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 132rpx;
  padding: 16rpx 28rpx 24rpx;
  color: var(--color-text-2);
  font-size: 26rpx;
  line-height: 1.6;
}
.medication-mascot { width: 88rpx; height: 88rpx; flex-shrink: 0; }

.dose-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 116rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid var(--color-border);
}
.dose-row:first-child { border-top: none; }
.dose-time {
  width: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-1);
  flex-shrink: 0;
}
.dose-main { flex: 1; min-width: 0; }
.dose-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-text-1);
  word-break: break-all;
}
.conflict-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}
.conflict-ico { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.dose-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--color-text-2);
}
.dose-btn { flex-shrink: 0; }

.plan-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  min-height: 132rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid var(--color-border);
}
.plan-row:first-child { border-top: none; }
.plan-main { flex: 1; min-width: 0; }
.plan-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-text-1);
  word-break: break-all;
}
.plan-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--color-text-2);
  word-break: break-all;
}
.plan-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.login-card { margin-top: 140rpx; }
