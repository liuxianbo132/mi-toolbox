<view class="page-root {{largeText ? 'large-text' : ''}}">
<state-view wx:if="{{loadState === 'loading'}}" title="正在加载物品" desc="整理批次与保质期信息，请稍候" compact="{{true}}" />

<state-view wx:elif="{{loadState === 'error'}}" icon="/assets/icons/alertCircle-red.svg" title="物品信息暂时无法加载" desc="{{loadError}}" action-text="重新加载" bindaction="retryload" />

<state-view wx:elif="{{loadState === 'not-found' || !item}}" icon="/assets/icons/box.svg" title="物品不存在或已被移入回收站" desc="可以返回库存页查看其他物品" />

<view wx:else class="page">
  <view class="card detail-card">
    <view wx:if="{{!editing}}">
      <view class="detail-head">
        <image class="detail-illu" src="{{item.itemIllu}}" mode="aspectFit" />
        <view class="detail-copy">
          <view class="detail-name">{{item.name}}</view>
          <view class="detail-meta">
            <view class="cat-chip">
              <text>{{item.categoryLabel}}</text>
            </view>
            <text wx:if="{{item.brand}}">{{item.brand}}</text>
            <text wx:if="{{item.spec}}">{{item.spec}}</text>
            <text wx:if="{{item.unit}}">{{item.unit}}</text>
          </view>
        </view>
        <button size="mini" class="btn-ghost detail-edit" bindtap="startEdit">编辑</button>
      </view>
      <view wx:if="{{item.paoDays}}" class="detail-condition">开封后有效期 {{item.paoDays}} 天</view>
      <view wx:if="{{item.category === 'medicine' && allergyState === 'ready' && myHits.length > 0}}" class="conflict-banner {{hitsWorst === 'forbidden' ? 'conflict-danger' : 'conflict-warn'}}">
        <text>你的过敏档案匹配记录 {{hitsSummary}}</text>
      </view>
    </view>
    <view wx:else>
      <view class="card-title">编辑物品</view>
      <view class="form-row">
        <text class="f-label">名称</text>
        <input class="ipt" value="{{editName}}" bindinput="onEditName" />
      </view>
      <view class="form-row">
        <text class="f-label">品类</text>
        <picker class="ipt-flex" mode="selector" range="{{categoryOptions}}" range-key="label" value="{{editCategoryIndex}}" bindchange="onEditCategory">
          <view class="ipt cat-picker">
            <image class="picker-ico" src="{{categoryOptions[editCategoryIndex].illustration}}" mode="aspectFit" />
            <text>{{categoryOptions[editCategoryIndex].label}}</text>
          </view>
        </picker>
      </view>
      <view class="form-row">
        <text class="f-label">单位</text>
        <input class="ipt" value="{{editUnit}}" bindinput="onEditUnit" />
      </view>
      <view class="form-row">
        <text class="f-label">品牌</text>
        <input class="ipt" value="{{editBrand}}" bindinput="onEditBrand" />
      </view>
      <view class="form-row">
        <text class="f-label">规格</text>
        <input class="ipt" value="{{editSpec}}" bindinput="onEditSpec" />
      </view>
      <view class="form-row">
        <text class="f-label">低库存提醒</text>
        <input class="ipt" type="number" maxlength="3" value="{{editLowStockThreshold}}" bindinput="onEditLowStockThreshold" placeholder="默认 0" />
      </view>
      <view class="hint-sm low-stock-hint">在库数量不超过此值时进入待补货列表。</view>
      <view class="form-row">
        <text class="f-label">开封后有效期</text>
        <input class="ipt" aria-label="开封后有效期天数" type="number" maxlength="4" value="{{editPaoDays}}" bindinput="onEditPaoDays" placeholder="选填，单位为天" />
      </view>
      <view class="hint-sm low-stock-hint">按包装标注填写。留空时按批次到期日管理。</view>
      <view class="edit-actions">
        <button size="mini" class="btn-ghost" bindtap="cancelEdit">取消</button>
        <button size="mini" class="btn-primary" loading="{{editSaving}}" disabled="{{editSaving}}" bindtap="saveEdit">保存</button>
      </view>
    </view>
  </view>

  <view class="zone">
    <view class="zone-head detail-zone-head">
      <text class="zone-title">在库批次{{batchState === 'ready' ? ' · ' + activeBatches.length : ''}}</text>
      <button size="mini" class="btn-primary" disabled="{{stockDeleting || batchState !== 'ready' || addSaving}}" bindtap="toggleAddBatch">{{addingBatch ? '收起' : '新增批次'}}</button>
    </view>
    <view wx:if="{{batchesLimited}}" class="batch-limit">当前显示部分批次。</view>

    <view wx:if="{{addingBatch}}" class="card">
      <batch-form id="addBatchForm" default-unit="{{item.unit}}" locations="{{locations}}" large-text="{{largeText}}"></batch-form>
      <button class="btn-primary add-save" loading="{{addSaving}}" disabled="{{addSaving}}" bindtap="saveNewBatch">保存批次</button>
    </view>

    <view wx:if="{{editingBatchId}}" class="card">
      <view class="card-title">编辑批次</view>
      <view class="form-row">
        <text class="f-label">到期日</text>
        <picker class="ipt-flex" mode="date" value="{{editingExpiry}}" bindchange="onEditBatchExpiry">
          <view class="ipt">{{editingExpiry || '选择日期'}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="f-label">数量</text>
        <input class="ipt" type="digit" value="{{editingQuantity}}" bindinput="onEditBatchQuantity" />
      </view>
      <view class="form-row">
        <text class="f-label">单位</text>
        <input class="ipt" value="{{editingUnit}}" bindinput="onEditBatchUnit" />
      </view>
      <view class="edit-actions">
        <button size="mini" class="btn-ghost" bindtap="cancelBatchEdit">取消</button>
        <button size="mini" class="btn-primary" loading="{{editBatchSaving}}" disabled="{{editBatchSaving}}" bindtap="saveBatchEdit">保存</button>
      </view>
    </view>

    <view wx:if="{{batchState === 'error'}}" class="state-inline">
      <text>批次信息暂时无法加载</text>
      <button size="mini" class="btn-ghost" bindtap="retryload">重试</button>
    </view>
    <view wx:elif="{{!addingBatch && !editingBatchId && activeBatches.length === 0}}" class="card center-hint">暂无在库批次，点右上角「新增批次」添加</view>

    <view wx:if="{{batchState === 'ready' && activeBatches.length > 0}}" class="card batch-group">
    <view wx:for="{{activeBatches}}" wx:for-item="b" wx:key="id" class="batch-row-detail">
      <view class="bc-top">
        <view class="bc-expiry">
          <text class="bc-date">{{b.displayExpiry !== b.expiry_date ? '实际到期' : '到期'}} {{b.displayExpiry}}</text>
          <text class="{{b.tagClass}}">{{b.daysText}}</text>
        </view>
        <view class="bc-side">
          <view class="bc-qty">{{b.quantity}} {{b.unit}}</view>
          <text wx:if="{{b.isOpened}}" class="opened-tag">已开封</text>
        </view>
      </view>
      <view class="bc-loc">{{b.locationName}}<text wx:if="{{b.displayExpiry !== b.expiry_date}}"> · 原到期日 {{b.expiry_date}}</text></view>
      <view class="bc-actions">
        <button wx:if="{{!b.isOpened}}" size="mini" class="btn-ghost" loading="{{batchBusy}}" disabled="{{batchBusy || stockDeleting || editBatchSaving}}" data-id="{{b.id}}" catchtap="markOpened" aria-label="标记批次 {{b.displayExpiry}} 已开封">开封</button>
        <button size="mini" class="btn-ghost" loading="{{batchBusy}}" disabled="{{batchBusy || stockDeleting || editBatchSaving}}" data-id="{{b.id}}" data-status="used" catchtap="setBatchStatus" aria-label="标记批次 {{b.displayExpiry}} 已用完">用完</button>
        <button size="mini" class="btn-danger" loading="{{batchBusy}}" disabled="{{batchBusy || stockDeleting || editBatchSaving}}" data-id="{{b.id}}" data-status="discarded" catchtap="setBatchStatus" aria-label="报废批次 {{b.displayExpiry}}，需二次确认">报废</button>
        <button size="mini" class="btn-ghost batch-menu" disabled="{{batchBusy || stockDeleting || editBatchSaving}}" data-id="{{b.id}}" bindtap="onBatchTap">更多</button>
      </view>
    </view>
    </view>
  </view>

  <view class="card" wx:if="{{batchState === 'ready' && historyBatches.length > 0}}">
    <view class="fold-head" hover-class="row-hover" bindtap="togglehistory">
      <view class="card-title fold-title">历史批次（{{historyBatches.length}}）</view>
      <text class="fold-arrow">{{historyExpanded ? '收起' : '展开'}}</text>
    </view>
    <block wx:if="{{historyExpanded}}">
      <view wx:for="{{historyBatches}}" wx:for-item="b" wx:key="id" class="batch-row" hover-class="row-hover" data-id="{{b.id}}" bindtap="onBatchTap">
        <view class="batch-info">
          <view class="batch-line"><text>到期 {{b.expiry_date}}</text></view>
          <view class="batch-sub">数量 {{b.quantity}} {{b.unit}} · 位置：{{b.locationName}}</view>
        </view>
        <text class="{{b.statusTagClass}}">{{b.statusLabel}}</text>
      </view>
    </block>
  </view>

  <view class="card" wx:if="{{item.category === 'medicine'}}">
    <view class="sec-head">
      <view class="card-title">用药计划（{{medPlans.length}}）</view>
      <button size="mini" class="btn-primary" bindtap="goNewPlan">新建计划</button>
    </view>
    <view wx:if="{{medPlansState === 'loading'}}" class="hint-sm">正在加载用药计划…</view>
    <view wx:elif="{{medPlansState === 'error'}}" class="state-inline">
      <text>用药计划加载失败</text>
      <button size="mini" class="btn-ghost" bindtap="retryload">重试</button>
    </view>
    <view wx:elif="{{medPlans.length === 0}}" class="hint-sm">暂无用药计划</view>
    <view wx:for="{{medPlans}}" wx:for-item="p" wx:key="id" class="plan-line" hover-class="row-hover" data-id="{{p.id}}" data-status="{{p.status}}" bindtap="goPlanEdit">
      <view class="plan-line-main">
        <view class="plan-line-title">{{p.timesText}} · {{p.freqLabel}}</view>
        <view class="plan-line-meta">{{p.memberName}} · {{p.courseText}}</view>
      </view>
      <text class="{{p.status === 'active' ? 'tag-green' : 'tag-amber'}}">{{p.statusLabel}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{item.category === 'medicine'}}">
    <view class="card-title">过敏关联（{{medLinks.length}}）</view>
    <view wx:if="{{allergyState === 'error'}}" class="state-inline">
      <text>{{allergyError}}</text>
      <button size="mini" class="btn-ghost" bindtap="retryload">重试</button>
    </view>
    <view wx:elif="{{allergyState === 'loading'}}" class="hint-sm">正在加载过敏关联…</view>
    <block wx:else>
      <view wx:if="{{allergyState === 'ready' && medLinks.length === 0}}" class="hint-sm">暂无过敏关联</view>
      <view wx:for="{{medLinks}}" wx:for-item="l" wx:key="id" class="link-row">
        <view class="link-main">
          <text class="link-allergen">{{l.allergen}}</text>
          <text class="{{l.kind === 'forbidden' ? 'tag-red' : 'tag-amber'}}">{{l.kindLabel}}</text>
          <text wx:if="{{l.hit}}" class="tag-red">命中</text>
        </view>
        <button size="mini" class="btn-ghost" loading="{{linkSaving}}" disabled="{{linkSaving}}" data-id="{{l.id}}" data-allergen="{{l.allergen}}" data-kind="{{l.kindLabel}}" bindtap="removeLink">删除</button>
      </view>
      <view class="form-row">
        <input class="ipt" value="{{linkAllergen}}" bindinput="onLinkAllergenInput" placeholder="过敏原，如 青霉素" maxlength="20" />
        <picker class="link-kind" mode="selector" range="{{linkKindOptions}}" range-key="label" value="{{linkKindIndex}}" bindchange="onLinkKindChange">
          <view class="ipt link-kind-value">{{linkKindOptions[linkKindIndex].label}}</view>
        </picker>
      </view>
      <button size="mini" class="btn-primary add-link-btn" loading="{{linkSaving}}" disabled="{{linkSaving}}" bindtap="addLink">添加关联</button>
    </block>
  </view>

  <view class="card delete-card">
    <view class="card-title">回收站</view>
    <button class="btn-danger" loading="{{stockDeleting}}" disabled="{{stockDeleting || batchBusy || addSaving || editBatchSaving || editSaving}}" bindtap="deleteItem">移入回收站</button>
  </view>
</view>
</view>
