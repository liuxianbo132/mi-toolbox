/* 页面独有样式；.center/.center-hint/.form-row/.ipt/.f-label 已收编至 app.wxss */

.ipt-flex {
  flex: 1;
  min-width: 0;
}

.page { padding: 8rpx 8rpx 40rpx; }

.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-2);
  margin-bottom: 12rpx;
}

.detail-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-xl);
  font-weight: 600;
  overflow-wrap: break-word;
}

.detail-head button {
  flex-shrink: 0;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx var(--space-3);
  align-items: center;
  color: var(--color-text-3);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.detail-condition {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
  color: var(--color-text-2);
  font-size: var(--font-sm);
  line-height: 1.45;
}
.detail-card .conflict-banner { margin: 16rpx 0 0; }

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-1);
}

.hint-sm {
  color: var(--color-text-3);
  font-size: var(--font-xs);
  padding: 12rpx 0;
  text-align: center;
}

.low-stock-hint {
  padding: 8rpx 0 12rpx;
  text-align: left;
}

.batch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-2) 0;
  border-top: 1rpx solid var(--color-border);
}

.batch-info {
  flex: 1;
  min-width: 0;
}

.batch-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--font-md);
}

.batch-sub {
  color: var(--color-text-3);
  font-size: var(--font-xs);
  margin-top: 4rpx;
}

.batch-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
  margin-top: var(--space-1);
}

.add-save {
  margin-top: var(--space-2);
}

.del-btn {
  width: 100%;
}

.plan-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  border-top: 1rpx solid var(--color-border);
}

.plan-line:first-child {
  border-top: none;
}

.plan-line-main {
  flex: 1;
  min-width: 0;
}

.plan-line-title {
  font-size: var(--font-md);
  font-weight: 500;
}

.plan-line-meta {
  color: var(--color-text-3);
  font-size: var(--font-xs);
  margin-top: 4rpx;
}

.link-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  border-top: 1rpx solid var(--color-border);
}

.link-row:first-child {
  border-top: none;
}

.link-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.link-allergen {
  font-size: var(--font-md);
}

.link-kind {
  width: 160rpx;
  flex-shrink: 0;
}

.link-kind-value {
  flex: none;
  text-align: center;
}

.add-link-btn {
  margin-top: var(--space-1);
}

.opened-tag {
  margin-left: 12rpx;
  background: var(--color-primary-light);
  color: var(--color-primary-ink);
  border-radius: var(--radius-sm);
  padding: 2rpx 10rpx;
  font-size: 20rpx;
}

/* ===== V2 Step1：在库批次卡片组 ===== */

.detail-zone-head { flex-wrap: wrap; gap: 8rpx 16rpx; }
.batch-limit { padding: 0 var(--space-3); margin: 8rpx 0; color: var(--color-text-2); }
.batch-group { padding: 0; overflow: hidden; }
.batch-row-detail { padding: 20rpx var(--space-3); }
.batch-row-detail + .batch-row-detail { border-top: 1rpx solid var(--color-border); }

.bc-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
}

.bc-expiry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  min-width: 0;
}

.bc-date {
  font-size: var(--font-lg);
  font-weight: 600;
}

.bc-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  max-width: 36%;
}

.bc-qty {
  color: var(--color-text-3);
  font-size: var(--font-xs);
  text-align: right;
  overflow-wrap: anywhere;
}

.bc-loc {
  margin-top: 6rpx;
  color: var(--color-text-3);
  font-size: var(--font-xs);
}

.bc-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--space-2);
}
.bc-actions button { min-width: 88rpx; }
.bc-actions .batch-menu { margin-left: auto; }

/* ===== V2 Step1：历史批次折叠 ===== */

.fold-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fold-title {
  margin-bottom: 0;
}

.fold-arrow {
  color: var(--color-primary-ink);
  font-size: 26rpx;
}

/* Unslop 精修：详情头图与可编辑批次提示 */
.detail-illu {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--color-bg);
  flex-shrink: 0;
}
.detail-copy { flex: 1; min-width: 0; }
.detail-meta text { color: var(--color-text-2); }
.fold-head { min-height: 88rpx; }
.delete-card { margin-top: var(--space-4); }
.delete-card .card-title { font-size: var(--font-md); color: var(--color-text-2); }
.large-text .detail-condition { font-size: 28rpx; }
.large-text .detail-card .form-row { align-items: stretch; flex-direction: column; gap: 8rpx; }
.large-text .detail-card .f-label { text-align: left; width: auto; }
