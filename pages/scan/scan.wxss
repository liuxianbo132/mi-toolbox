/* 扫码录入页；公共类已收编至 app.wxss */

.scan-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.scan-actions button {
  min-width: 144rpx;
}

.scan-code {
  color: var(--color-text-3);
  font-size: var(--font-xs);
  line-height: 1.45;
  margin-top: var(--space-1);
  word-break: break-all;
}

.scan-mascot {
  display: block;
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto 16rpx;
}
