.scan-card {
  margin: var(--space-4);
  padding: 48rpx var(--space-4) var(--space-4);
  text-align: center;
}

.scan-status-icon {
  display: block;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto var(--space-3);
}

.scan-title { margin-bottom: var(--space-1); }
.scan-message, .scan-code {
  color: var(--color-text-2);
  line-height: 1.5;
  overflow-wrap: break-word;
}
.scan-code { margin-top: var(--space-1); font-size: var(--font-sm); }
.scan-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: var(--space-3); }
.scan-actions button { flex: 1; min-width: 210rpx; margin: 0; padding-inline: 12rpx; }
