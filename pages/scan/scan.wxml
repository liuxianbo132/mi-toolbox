<view wx:if="{{status === 'scanning'}}" class="center">正在启动扫码…</view>

<view wx:elif="{{status === 'error'}}" class="card center-hint">
  <view>{{errorText || '扫码未完成'}}</view>
  <view wx:if="{{lastCode}}" class="scan-code">已识别：{{lastCode}}</view>
  <view class="scan-actions">
    <button size="mini" class="btn-ghost" bindtap="retry">重扫</button>
    <button size="mini" class="btn-primary" bindtap="goBack">返回</button>
  </view>
</view>

<view wx:elif="{{status === 'no-household'}}" class="card center-hint">
  <view>请先在「临期看板」创建或加入家庭</view>
  <view class="scan-actions">
    <button size="mini" class="btn-primary" bindtap="goBack">返回</button>
  </view>
</view>

<view wx:else class="center">处理中…</view>
